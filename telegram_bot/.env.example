# Бот
BOT_TOKEN=ваш_токен_бота_от_BotFather
ADMIN_GROUP_CHAT_ID=-1001234567890

# База данных
DATABASE_URL=postgresql://bot_user:strong_password_here@postgres:5432/telegram_bot

# Site
BOT_API_KEY
SITE_DOMAIN

# Опционально: прокси к api.telegram.org (HTTP / HTTPS / SOCKS5). Если прокси нет —
# строку PROXY_URL не добавляйте (или оставьте пустой: PROXY_URL=).
# Пример: socks5://127.0.0.1:1080
# В Docker к прокси на хосте: socks5://host.docker.internal:1080

# Опционально: таймауты к Telegram (секунды). Ниже — заводские «медленный канал»; при быстрой сети можно уменьшить.
# TG_CONNECT_TIMEOUT=30
# TG_READ_TIMEOUT=90
# TG_WRITE_TIMEOUT=90
# TG_POOL_TIMEOUT=45
# Long poll: 0..50 с на стороне Telegram; HTTP read getUpdates должен быть больше long poll (по умолчанию 95).
# TG_LONG_POLL_TIMEOUT=40
# TG_GET_UPDATES_CONNECT_TIMEOUT=30
# TG_GET_UPDATES_READ_TIMEOUT=95
# TG_GET_UPDATES_WRITE_TIMEOUT=90
# TG_GET_UPDATES_POOL_TIMEOUT=45
# Повторы при старте до первого успешного getUpdates (<0 = бесконечно)
# TG_BOOTSTRAP_RETRIES=-1